# ─── Required ───────────────────────────────────────────────────────────────
# Neon Postgres pooled connection string
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
# 32+ random bytes — signs session cookies. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-32-plus-random-characters-please"
APP_URL="http://localhost:3000"

# ─── Optional: AI fix recommendations (falls back to built-in copy) ─────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ─── Optional: citation engines ─────────────────────────────────────────────
# Any engine left blank runs in deterministic SIMULATED mode and is labelled
# as such everywhere, including exports. Crawling/scoring never needs a key.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"
# Google AI Overviews via DataForSEO (SERP Advanced)
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ─── Optional: Stripe billing (upgrade UI degrades to a notice without it) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_AGENCY=""

# ─── Optional: scheduled runs from n8n ──────────────────────────────────────
# n8n calls POST /api/cron/weekly with `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=""
N8N_WEBHOOK_URL="https://gmkmedia.app.n8n.cloud/webhook/citation-radar"

# ─── Crawler tuning ─────────────────────────────────────────────────────────
CRAWL_USER_AGENT="CitationRadarBot/1.0 (+https://citationradar.app/bot)"
CRAWL_MAX_PAGES_HARD_CAP="2000"
